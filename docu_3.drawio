        <mxCell id="YADAe_sK0ECxlJWNLnll-137" parent="YADAe_sK0ECxlJWNLnll-136" style="text;html=1;fontSize=84;fontStyle=1;verticalAlign=middle;align=center;autosizeText=1;fillColor=inherit;fillStyle=solid;rotatable=0;resizable=1;movable=1;" value="ENGINES" vertex="1">
