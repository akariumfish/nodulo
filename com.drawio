        </mxCell>
        <mxCell id="JMeg28QFHQqCXGKKknAn-139" parent="JMeg28QFHQqCXGKKknAn-138" style="text;strokeColor=none;fillColor=none;html=1;fontSize=84;fontStyle=1;verticalAlign=middle;align=center;autosizeText=1;" value="ENGINE" vertex="1">
